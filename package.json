{
  "name": "adt-html-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --config vite.lib.config.ts && tsc -p tsconfig.types.json",
    "build:playground": "vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.0",
    "@atlaskit/pragmatic-drag-and-drop-live-region": "^2.1.0",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/store": "^0.11.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tiny-invariant": "^1.3.3",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop-unit-testing": "^2.1.0",
    "@babel/core": "^7.29.7",
    "@base-ui/react": "^1.8.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.46.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-doctor": "^0.9.13",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.4",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shadcn": {
      "types": "./dist/shadcn/index.d.ts",
      "import": "./dist/shadcn.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@base-ui/react": "^1.8.0",
    "lucide-react": ">=0.400.0",
    "class-variance-authority": "^0.7.0",
    "cn": "^0.3.0",
    "cmdk": "^1.1.0",
    "react-resizable-panels": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "class-variance-authority": {
      "optional": true
    },
    "cn": {
      "optional": true
    },
    "cmdk": {
      "optional": true
    },
    "react-resizable-panels": {
      "optional": true
    }
  }
}
