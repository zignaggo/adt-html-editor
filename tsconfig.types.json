{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.types.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "allowImportingTsExtensions": false,
    "outDir": "./dist",
    "rootDir": "./src/lib"
  },
  "include": [
    "src/lib"
  ],
  "exclude": [
    "src/lib/**/*.test.ts",
    "src/lib/**/*.test.tsx"
  ]
}
